program(1.0)
[buildInfo = dict<tensor<string, []>, tensor<string, []>>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios17>(tensor<fp16, [1, 64, 1, 16384]> features) {
            tensor<fp16, [32, 64, 1, 1]> dense_1_weight_0 = const()[name = tensor<string, []>("dense_1_weight_0"), val = tensor<fp16, [32, 64, 1, 1]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(64)))];
            tensor<fp16, [32]> dense_1_bias_0 = const()[name = tensor<string, []>("dense_1_bias_0"), val = tensor<fp16, [32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(4224)))];
            tensor<int32, [2]> dense_1_strides_0 = const()[name = tensor<string, []>("dense_1_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> dense_1_pad_type_0 = const()[name = tensor<string, []>("dense_1_pad_type_0"), val = tensor<string, []>("valid")];
            tensor<int32, [4]> dense_1_pad_0 = const()[name = tensor<string, []>("dense_1_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> dense_1_dilations_0 = const()[name = tensor<string, []>("dense_1_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> dense_1_groups_0 = const()[name = tensor<string, []>("dense_1_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 32, 1, 16384]> dense_1 = conv(bias = dense_1_bias_0, dilations = dense_1_dilations_0, groups = dense_1_groups_0, pad = dense_1_pad_0, pad_type = dense_1_pad_type_0, strides = dense_1_strides_0, weight = dense_1_weight_0, x = features)[name = tensor<string, []>("dense_1")];
            tensor<fp16, [1, 32, 1, 16384]> relu_1 = relu(x = dense_1)[name = tensor<string, []>("relu_1")];
            tensor<fp16, [16, 32, 1, 1]> dense_2_weight_0 = const()[name = tensor<string, []>("dense_2_weight_0"), val = tensor<fp16, [16, 32, 1, 1]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(4352)))];
            tensor<fp16, [16]> dense_2_bias_0 = const()[name = tensor<string, []>("dense_2_bias_0"), val = tensor<fp16, [16]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(5440)))];
            tensor<int32, [2]> dense_2_strides_0 = const()[name = tensor<string, []>("dense_2_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> dense_2_pad_type_0 = const()[name = tensor<string, []>("dense_2_pad_type_0"), val = tensor<string, []>("valid")];
            tensor<int32, [4]> dense_2_pad_0 = const()[name = tensor<string, []>("dense_2_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> dense_2_dilations_0 = const()[name = tensor<string, []>("dense_2_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> dense_2_groups_0 = const()[name = tensor<string, []>("dense_2_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 16, 1, 16384]> dense_2 = conv(bias = dense_2_bias_0, dilations = dense_2_dilations_0, groups = dense_2_groups_0, pad = dense_2_pad_0, pad_type = dense_2_pad_type_0, strides = dense_2_strides_0, weight = dense_2_weight_0, x = relu_1)[name = tensor<string, []>("dense_2")];
            tensor<fp16, [1, 16, 1, 16384]> relu_2 = relu(x = dense_2)[name = tensor<string, []>("relu_2")];
            tensor<fp16, [1, 16, 1, 1]> logit_weight_0 = const()[name = tensor<string, []>("logit_weight_0"), val = tensor<fp16, [1, 16, 1, 1]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(5568)))];
            tensor<fp16, [1]> logit_bias_0 = const()[name = tensor<string, []>("logit_bias_0"), val = tensor<fp16, [1]>([-0x1.b58p-3])];
            tensor<int32, [2]> logit_strides_0 = const()[name = tensor<string, []>("logit_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> logit_pad_type_0 = const()[name = tensor<string, []>("logit_pad_type_0"), val = tensor<string, []>("valid")];
            tensor<int32, [4]> logit_pad_0 = const()[name = tensor<string, []>("logit_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> logit_dilations_0 = const()[name = tensor<string, []>("logit_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> logit_groups_0 = const()[name = tensor<string, []>("logit_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 1, 1, 16384]> logit = conv(bias = logit_bias_0, dilations = logit_dilations_0, groups = logit_groups_0, pad = logit_pad_0, pad_type = logit_pad_type_0, strides = logit_strides_0, weight = logit_weight_0, x = relu_2)[name = tensor<string, []>("logit")];
            tensor<fp16, [1, 1, 1, 16384]> probability = sigmoid(x = logit)[name = tensor<string, []>("probability")];
            tensor<fp16, []> risk_score_y_0 = const()[name = tensor<string, []>("risk_score_y_0"), val = tensor<fp16, []>(0x1.9p+6)];
            tensor<fp16, [1, 1, 1, 16384]> risk_score = mul(x = probability, y = risk_score_y_0)[name = tensor<string, []>("risk_score")];
        } -> (risk_score);
}