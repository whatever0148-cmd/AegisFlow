            tensor<bool, []> window_mean_keep_dims_0 = const()[name = tensor<string, []>("window_mean_keep_dims_0"), val = tensor<bool, []>(true)];
            tensor<fp16, [1, 128, 8, 1]> window_mean = reduce_mean(axes = window_mean_axes_0, keep_dims = window_mean_keep_dims_0, x = blocks_4_relu)[name = tensor<string, []>("window_mean")];
            tensor<int32, []> readout_features_axis_0 = const()[name = tensor<string, []>("readout_features_axis_0"), val = tensor<int32, []>(1)];
            tensor<bool, []> readout_features_interleave_0 = const()[name = tensor<string, []>("readout_features_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 256, 8, 1]> readout_features = concat(axis = readout_features_axis_0, interleave = readout_features_interleave_0, values = (newest, window_mean))[name = tensor<string, []>("readout_features")];
            tensor<fp16, [64, 256, 8, 1]> head_0_weight_0 = const()[name = tensor<string, []>("head_0_weight_0"), val = tensor<fp16, [64, 256, 8, 1]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(677120)))];
            tensor<fp16, [64]> head_0_bias_0 = const()[name = tensor<string, []>("head_0_bias_0"), val = tensor<fp16, [64]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(939328)))];
            tensor<int32, [2]> head_0_strides_0 = const()[name = tensor<string, []>("head_0_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> head_0_dilations_0 = const()[name = tensor<string, []>("head_0_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> head_0_pad_type_0 = const()[name = tensor<string, []>("head_0_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> head_0_pad_0 = const()[name = tensor<string, []>("head_0_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, []> head_0_groups_0 = const()[name = tensor<string, []>("head_0_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 64, 1, 1]> head_0 = conv(bias = head_0_bias_0, dilations = head_0_dilations_0, groups = head_0_groups_0, pad = head_0_pad_0, pad_type = head_0_pad_type_0, strides = head_0_strides_0, weight = head_0_weight_0, x = readout_features)[name = tensor<string, []>("head_0")];
            tensor<fp16, [1, 64, 1, 1]> head_0_relu = relu(x = head_0)[name = tensor<string, []>("head_0_relu")];
            tensor<fp16, [1, 64, 1, 1]> head_1_weight_0 = const()[name = tensor<string, []>("head_1_weight_0"), val = tensor<fp16, [1, 64, 1, 1]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(939520)))];
            tensor<fp16, [1]> head_1_bias_0 = const()[name = tensor<string, []>("head_1_bias_0"), val = tensor<fp16, [1]>([-0x1.27cp-5])];
            tensor<int32, [2]> head_1_strides_0 = const()[name = tensor<string, []>("head_1_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> head_1_dilations_0 = const()[name = tensor<string, []>("head_1_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<string, []> head_1_pad_type_0 = const()[name = tensor<string, []>("head_1_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> head_1_pad_0 = const()[name = tensor<string, []>("head_1_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, []> head_1_groups_0 = const()[name = tensor<string, []>("head_1_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [1, 1, 1, 1]> head_1 = conv(bias = head_1_bias_0, dilations = head_1_dilations_0, groups = head_1_groups_0, pad = head_1_pad_0, pad_type = head_1_pad_type_0, strides = head_1_strides_0, weight = head_1_weight_0, x = head_0_relu)[name = tensor<string, []>("head_1")];
            tensor<fp16, [1, 1, 1, 1]> probability = sigmoid(x = head_1)[name = tensor<string, []>("probability")];
            tensor<fp16, []> risk_score_y_0 = const()[name = tensor<string, []>("risk_score_y_0"), val = tensor<fp16, []>(0x1.9p+6)];
            tensor<fp16, [1, 1, 1, 1]> risk_score = mul(x = probability, y = risk_score_y_0)[name = tensor<string, []>("risk_score")];
        } -> (risk_score);
}